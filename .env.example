# EntroWorld local configuration. `pnpm setup` copies this file to .env and fills every
# __generate__ value with a random secret. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# --- Data stores (docker compose: `pnpm infra:up`) ---------------------------------------
DATABASE_URL=postgres://entroworld:entroworld@127.0.0.1:5432/entroworld
REDIS_URL=redis://127.0.0.1:6379

# --- Shared secrets ------------------------------------------------------------------------
# Signs the short-lived room tickets the API issues and the game server verifies.
GAME_TICKET_SECRET=__generate__
JWT_ACCESS_SECRET=__generate__

# --- Web -----------------------------------------------------------------------------------
WEB_PORT=5173

# --- API -----------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3001
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
GAME_SERVER_PUBLIC_URL=/game

# --- Game server ---------------------------------------------------------------------------
GAME_HOST=127.0.0.1
GAME_PORT=2567
GAME_SERVER_ID=game-1
# Redis-backed presence/matchmaking (needed for more than one game-server process).
# Requires Redis from `pnpm infra:up`; set to false to run the game server without Redis.
USE_REDIS_PRESENCE=true
# Avatars, saved positions and room instances in PostgreSQL (false = run the game server without a database)
GAME_PERSISTENCE=true
# Development only: POST /game/dev/ticket issues guest tickets (used by /dev/multiplayer).
GAME_DEV_TICKETS=true

# --- AI agent service (AI Agent Street shopkeepers) ---------------------------------------
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=3002
# Internal URL the API uses to reach the AI agent service.
AI_SERVICE_URL=http://127.0.0.1:3002
# Shared secret between the API and the AI agent service (required in production).
AI_SERVICE_TOKEN=__generate__
# "anthropic" (Claude) or "mock" (offline canned replies for development). When unset, the
# service uses Claude if an API key is configured, otherwise the mock.
AI_PROVIDER=
# Claude API key. Never sent to browsers. ANTHROPIC_API_KEY also works.
AI_PROVIDER_API_KEY=
AI_DEFAULT_MODEL=claude-opus-5-5
AI_DEFAULT_EFFORT=low
AI_USER_DAILY_REQUEST_LIMIT=50
AI_USER_DAILY_TOKEN_LIMIT=50000
AI_MODERATION_ENABLED=true

# --- Object storage (MinIO in development) -------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_URL=http://127.0.0.1:9000
S3_BUCKET=entroworld-media
S3_ACCESS_KEY=entroworld
S3_SECRET_KEY=__generate__

# --- Voice (optional; leave empty to disable proximity voice) ------------------------------
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
