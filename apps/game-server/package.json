{
  "name": "@entroworld/game-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "node ../../infra/scripts/build-node.mjs src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.28",
    "@colyseus/redis-driver": "^0.18.7",
    "@colyseus/redis-presence": "^0.18.6",
    "@colyseus/schema": "^5.0.48",
    "@colyseus/ws-transport": "^0.18.5",
    "@entroworld/avatar": "workspace:*",
    "@entroworld/config": "workspace:*",
    "@entroworld/database": "workspace:*",
    "@entroworld/game-engine": "workspace:*",
    "@entroworld/game-protocol": "workspace:*",
    "@entroworld/puzzle-engine": "workspace:*",
    "@entroworld/robot-api": "workspace:*",
    "@entroworld/shared": "workspace:*",
    "@entroworld/world-assets": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "livekit-server-sdk": "~2.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.10",
    "@colyseus/testing": "^0.18.6"
  }
}
