{
  "name": "@entroworld/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "node ../../infra/scripts/build-node.mjs src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@entroworld/agent-protocol": "workspace:*",
    "@entroworld/avatar": "workspace:*",
    "@entroworld/config": "workspace:*",
    "@entroworld/database": "workspace:*",
    "@entroworld/game-protocol": "workspace:*",
    "@entroworld/puzzle-engine": "workspace:*",
    "@entroworld/robot-api": "workspace:*",
    "@entroworld/shared": "workspace:*",
    "@entroworld/validation": "workspace:*",
    "@entroworld/world-assets": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/websocket": "^11.3.7",
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^6.7.6",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "livekit-server-sdk": "~2.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@entroworld/ai-agent-service": "workspace:*",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.1",
    "pg": "^8.23.1",
    "ws": "^8.18.3"
  }
